---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SiteSections from '../components/SiteSections.astro';
---
<BaseLayout title="1031 CapEx | Defer Taxes. Earn Interest on Your Funds">
  <main class="hero">
    <div class="backdrop" aria-hidden="true"></div>
    <Header />
    <section class="hero-content" aria-labelledby="hero-title">
      <p class="eyebrow">1031 EXCHANGE, MADE SIMPLE</p>
      <h1 id="hero-title">Defer Taxes.<br /><span class="earn-pill">Earn Interest</span> on Your Funds.</h1>
      <p class="intro">A streamlined 1031 exchange experience built for real estate<br class="desktop-break" /> investors, advisors, and property owners.</p>

      <div class="hero-cards">
        <!-- Card 1: $0 Exchange Fee -->
        <div class="offer-card">
          <img src="/images/icon-exchange-fee.png" alt="Exchange fee" class="offer-card-icon" />
          <div class="offer-sep" aria-hidden="true"></div>
          <div class="offer-body">
            <span class="offer-num">$0</span>
            <div class="offer-text">
              <strong>Exchange Fee</strong>
              <span>No setup or wire fees</span>
            </div>
          </div>
        </div>

        <!-- Card 2: Earn up to 1.25% APR -->
        <div class="offer-card">
          <img src="/images/icon-apr-rate.png" alt="APR rate" class="offer-card-icon" />
          <div class="offer-sep" aria-hidden="true"></div>
          <div class="offer-rate-content">
            <span class="offer-rate-label">Earn up to</span>
            <div class="offer-rate-row">
              <span class="offer-num">1.25%</span>
              <span class="apr-pill">APR</span>
            </div>
          </div>
        </div>
      </div>

      <div class="cta-row">
        <a class="button secondary" href="#services">Explore 1031 Exchanges</a>
        <a class="button primary" href="#contact">Start Your Exchange <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <SiteSections />
</BaseLayout>

<style>
  .hero { position: relative; isolation: isolate; min-height: min(940px, 100svh); overflow: hidden; border-radius: 0 0 34px 34px; display: flex; flex-direction: column; }
  .backdrop { position: absolute; z-index: -2; inset: 0; background: #d8edfb url('/images/city-hero.png') center top / 100% 120% no-repeat; }
  .backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(236,247,255,.22) 0%, rgba(246,251,255,.07) 40%, rgba(1,20,42,.08) 100%); }
  .hero-content { width: min(1120px, calc(100% - 40px)); margin: clamp(35px, 5vh, 50px) auto 40px; text-align: center; }
  .eyebrow { display: none; margin: 0 0 16px; color: #0a71bf; font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  h1 { margin: 0; color: #031337; font: 800 clamp(42px, 5.2vw, 76px)/1.04 'Manrope', sans-serif; letter-spacing: -.055em; }
  .intro { margin: 20px auto 0; color: #35537e; font: 500 clamp(18px, 1.65vw, 26px)/1.32 'DM Sans', sans-serif; letter-spacing: -.035em; }

  /* Earn Interest blue pill in headline */
  .earn-pill {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-style: italic;
    font-weight: 800;
    padding: 0 18px 2px 16px;
    margin-right: 12px;
    vertical-align: middle;
    transform: translateY(-4px);
    letter-spacing: -.03em;
    line-height: 0.9;
  }
  .earn-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, #0280e5 0%, #0093f5 100%);
    border-radius: 28px;
    transform: skewX(-8deg);
    box-shadow: 0 4px 16px rgba(0, 114, 227, 0.28);
    pointer-events: none;
  }

  /* Two offer cards row */
  .hero-cards {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 32px auto 32px;
    flex-wrap: wrap;
  }

  /* Individual card */
  .offer-card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    padding: 12px 26px 12px 16px;
    background: transparent;
  }
  .offer-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #ffffff;
    border: 1px solid rgba(8, 116, 201, 0.16);
    border-radius: 36px;
    transform: skewX(-10deg);
    box-shadow: 0 10px 28px rgba(4, 38, 95, 0.06), 0 2px 6px rgba(4, 38, 95, 0.03);
    backdrop-filter: blur(10px);
    pointer-events: none;
  }

  /* Icon image */
  .offer-card-icon {
    width: 58px;
    height: 58px;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
  }

  /* Vertical separator */
  .offer-sep {
    width: 1px;
    height: 44px;
    margin: 0 18px 0 16px;
    background: rgba(8, 116, 201, 0.16);
    flex-shrink: 0;
  }

  /* Blue numbers ($0 and 1.25%) */
  .offer-num {
    color: #007eed;
    font: 800 44px/1 'Manrope', sans-serif;
    letter-spacing: -.04em;
  }

  /* Card 1 content */
  .offer-body {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .offer-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .offer-text strong {
    color: #051938;
    font: 700 17px/1.2 'Manrope', sans-serif;
    letter-spacing: -.01em;
  }

  .offer-text span {
    color: #5d728e;
    font: 400 13.5px/1.3 'DM Sans', sans-serif;
  }

  /* Card 2 content */
  .offer-rate-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    text-align: left;
  }

  .offer-rate-label {
    color: #051938;
    font: 700 15px/1.1 'Manrope', sans-serif;
    letter-spacing: -.01em;
  }

  .offer-rate-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 1px;
  }

  /* APR badge */
  .apr-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #007eed;
    color: #ffffff;
    font: 800 13px/1 'Manrope', sans-serif;
    padding: 5px 14px;
    border-radius: 999px;
    letter-spacing: .04em;
  }

  /* CTA buttons */
  .cta-row { display: flex; justify-content: center; gap: 14px; margin-top: 0; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 28px; border-radius: 12px; font-size: 15px; font-weight: 700; transition: transform .2s ease, background .2s ease; }
  .button:hover { transform: translateY(-2px); }
  .secondary { color: #07235a; border: 1.5px solid #0879d4; background: rgba(255,255,255,.88); box-shadow: 0 3px 9px rgba(1,38,85,.06); }
  .primary { color: #fff; background: #0874c9; box-shadow: 0 8px 20px rgba(0,96,180,.24); }
  .primary:hover { background: #0568b4; }
  .primary span { font-size: 20px; line-height: 1; }

  /* Mobile */
  @media (max-width: 720px) {
    .hero { min-height: 760px; border-radius: 0 0 24px 24px; }
    .backdrop { background-position: 58% center; }
    .backdrop::after { background: linear-gradient(180deg, rgba(235,247,255,.3), rgba(248,251,255,.2) 55%, rgba(0,28,55,.14)); }
    .hero-content { margin-top: 84px; width: min(100% - 32px, 560px); }
    .eyebrow { display: block; }
    h1 { font-size: clamp(32px, 8vw, 46px); line-height: 1.1; letter-spacing: -.04em; }
    .earn-pill { padding: 0 14px 2px 12px; margin-right: 8px; transform: translateY(-2px); line-height: 0.9; }
    .earn-pill::before { transform: none; border-radius: 16px; }
    .intro { margin-top: 18px; font-size: 18px; line-height: 1.42; }
    .desktop-break { display: none; }
    .hero-cards { flex-direction: column; align-items: stretch; max-width: 380px; margin: 22px auto 24px; gap: 12px; }
    .offer-card { padding: 12px 18px 12px 14px; }
    .offer-card::before { transform: none; border-radius: 20px; }
    .offer-card-icon { width: 48px; height: 48px; }
    .offer-sep { margin: 0 12px; height: 38px; }
    .offer-num { font-size: 36px; }
    .cta-row { flex-direction: column; align-items: stretch; margin: 0 auto; max-width: 325px; }
    .button { min-height: 54px; }
  }
</style>

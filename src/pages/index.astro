---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SiteSections from '../components/SiteSections.astro';
---
<BaseLayout title="1031 CapEx | Defer Taxes. Earn Interest on Your Funds">
  <main class="hero">
    <div class="backdrop" aria-hidden="true"></div>
    <Header />
    <section class="hero-content" aria-labelledby="hero-title">
      <p class="eyebrow">1031 EXCHANGE, MADE SIMPLE</p>
      <h1 id="hero-title">Defer Taxes.<br /><span class="earn-text">Earn Interest</span> on Your Funds.</h1>
      <p class="intro">A streamlined 1031 exchange experience built for real estate<br class="desktop-break" /> investors, advisors, and property owners.</p>

      <div class="hero-cards">
        <!-- Benefit 1: $0 exchange fee -->
        <div class="offer-card">
          <span class="offer-val">$0</span>
          <span class="offer-label">Exchange Fee</span>
        </div>

        <!-- Benefit 2: Earn up to 1.25% APR -->
        <div class="offer-card">
          <span class="offer-prefix">Earn up to</span>
          <span class="offer-val">1.25%</span>
          <span class="apr-tag">APR</span>
        </div>
      </div>

      <div class="cta-row">
        <a class="button secondary" href="#services">Explore 1031 Exchanges</a>
        <a class="button primary" href="#contact">Start Your Exchange <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <SiteSections />
</BaseLayout>

<style>
  .hero { position: relative; isolation: isolate; min-height: min(940px, 100svh); overflow: hidden; border-radius: 0 0 34px 34px; display: flex; flex-direction: column; }
  .backdrop { position: absolute; z-index: -2; inset: 0; background: #d8edfb url('/images/city-hero.png') center top / 100% 120% no-repeat; }
  .backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(236,247,255,.22) 0%, rgba(246,251,255,.07) 40%, rgba(1,20,42,.08) 100%); }
  .hero-content { width: min(1120px, calc(100% - 40px)); margin: clamp(35px, 5vh, 50px) auto 40px; text-align: center; }
  .eyebrow { display: none; margin: 0 0 16px; color: #0a71bf; font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  h1 { margin: 0; color: #031337; font: 800 clamp(42px, 5.2vw, 76px)/1.04 'Manrope', sans-serif; letter-spacing: -.055em; }
  .intro { margin: 20px auto 0; color: #35537e; font: 500 clamp(18px, 1.65vw, 26px)/1.32 'DM Sans', sans-serif; letter-spacing: -.035em; }

  /* Earn Interest clean text accent - no background highlight */
  .earn-text {
    color: #0077e6;
  }

  /* Two offer cards row - ultra-minimal design */
  .hero-cards {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 24px auto 28px;
    flex-wrap: wrap;
  }

  /* Individual minimal card */
  .offer-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid rgba(3, 19, 55, 0.08);
    box-shadow: 0 2px 8px rgba(4, 38, 95, 0.04);
  }

  /* Blue values ($0 and 1.25%) */
  .offer-val {
    color: #0077e6;
    font: 800 28px/1 'Manrope', sans-serif;
    letter-spacing: -.03em;
  }

  /* Labels */
  .offer-label {
    color: #031337;
    font: 700 15px/1 'Manrope', sans-serif;
    letter-spacing: -.01em;
  }

  .offer-prefix {
    color: #64748b;
    font: 600 14px/1 'DM Sans', sans-serif;
  }

  /* APR tag */
  .apr-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eaf3fd;
    color: #0077e6;
    font: 800 11px/1 'Manrope', sans-serif;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: .03em;
    margin-left: 2px;
  }

  /* CTA buttons */
  .cta-row { display: flex; justify-content: center; gap: 14px; margin-top: 0; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 28px; border-radius: 12px; font-size: 15px; font-weight: 700; transition: transform .2s ease, background .2s ease; }
  .button:hover { transform: translateY(-2px); }
  .secondary { color: #07235a; border: 1.5px solid #0879d4; background: rgba(255,255,255,.88); box-shadow: 0 3px 9px rgba(1,38,85,.06); }
  .primary { color: #fff; background: #0874c9; box-shadow: 0 8px 20px rgba(0,96,180,.24); }
  .primary:hover { background: #0568b4; }
  .primary span { font-size: 20px; line-height: 1; }

  /* Mobile */
  @media (max-width: 720px) {
    .hero { min-height: 760px; border-radius: 0 0 24px 24px; }
    .backdrop { background-position: 58% center; }
    .backdrop::after { background: linear-gradient(180deg, rgba(235,247,255,.3), rgba(248,251,255,.2) 55%, rgba(0,28,55,.14)); }
    .hero-content { margin-top: 84px; width: min(100% - 32px, 560px); }
    .eyebrow { display: block; }
    h1 { font-size: clamp(32px, 8vw, 46px); line-height: 1.1; letter-spacing: -.04em; }
    .intro { margin-top: 18px; font-size: 18px; line-height: 1.42; }
    .desktop-break { display: none; }
    .hero-cards { flex-direction: column; align-items: stretch; max-width: 300px; margin: 18px auto 22px; gap: 8px; }
    .offer-card { padding: 9px 18px; }
    .offer-val { font-size: 24px; }
    .cta-row { flex-direction: column; align-items: stretch; margin: 0 auto; max-width: 325px; }
    .button { min-height: 54px; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SiteSections from '../components/SiteSections.astro';
---
<BaseLayout title="1031 CapEx | Defer Taxes. Earn Interest on Your Funds">
  <main class="hero">
    <div class="backdrop" aria-hidden="true"></div>
    <Header />
    <section class="hero-content" aria-labelledby="hero-title">
      <p class="eyebrow">1031 EXCHANGE, MADE SIMPLE</p>
      <h1 id="hero-title">Defer Taxes.<br />Earn Interest on Your Funds</h1>
      <p class="intro">A streamlined 1031 exchange experience built for real estate<br class="desktop-break" /> investors, advisors, and property owners.</p>
      <div class="cta-row">
        <a class="button secondary" href="#services">Explore 1031 Exchanges</a>
        <a class="button primary" href="#contact">Start Your Exchange <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-perks">
        <span class="perk-pill">
          <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          $0 Exchange Fee
        </span>
        <span class="perk-pill">
          <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Earn up to 1.25% APR
        </span>
      </div>
    </section>
    <div class="scroll-hint" aria-hidden="true"><span></span> Scroll to explore</div>
  </main>
  <SiteSections />
</BaseLayout>

<style>
  .hero { position: relative; isolation: isolate; min-height: min(940px, 100svh); overflow: hidden; border-radius: 0 0 34px 34px; display: flex; flex-direction: column; }
  .backdrop { position: absolute; z-index: -2; inset: 0; background: #d8edfb url('/images/city-hero.png') center top / 100% 120% no-repeat; }
  .backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(236,247,255,.22) 0%, rgba(246,251,255,.07) 40%, rgba(1,20,42,.08) 100%); }
  .hero-content { width: min(1120px, calc(100% - 40px)); margin: clamp(35px, 5vh, 50px) auto 40px; text-align: center; }
  .eyebrow { display: none; margin: 0 0 16px; color: #0a71bf; font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  h1 { margin: 0; color: #031337; font: 800 clamp(42px, 5.2vw, 76px)/1.04 'Manrope', sans-serif; letter-spacing: -.055em; }
  .intro { margin: 20px auto 0; color: #35537e; font: 500 clamp(18px, 1.65vw, 26px)/1.32 'DM Sans', sans-serif; letter-spacing: -.035em; }
  .cta-row { display: flex; justify-content: center; gap: 14px; margin-top: 26px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 59px; padding: 0 28px; border-radius: 12px; font-size: 16px; font-weight: 700; transition: transform .2s ease, background .2s ease; }
  .button:hover { transform: translateY(-2px); }
  .secondary { color: #07235a; border: 1.5px solid #0879d4; background: rgba(255,255,255,.86); box-shadow: 0 3px 9px rgba(1,38,85,.06); }
  .primary { color: #fff; background: #0874c9; box-shadow: 0 8px 20px rgba(0,96,180,.24); }
  .primary:hover { background: #0568b4; }
  .primary span { font-size: 20px; line-height: 1; }
  .hero-perks { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 26px; }
  .perk-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 20px; border-radius: 999px; background: rgba(255,255,255,.94); border: 1.5px solid rgba(8,116,201,.25); color: #082558; font-size: 14px; font-weight: 700; box-shadow: 0 4px 14px rgba(4,38,95,.06); backdrop-filter: blur(6px); letter-spacing: -.01em; }
  .check-icon { width: 17px; height: 17px; color: #0874c9; flex-shrink: 0; }
  .scroll-hint { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 9px; color: rgba(255,255,255,.88); font-size: 12px; font-weight: 600; text-shadow: 0 1px 4px rgba(0,0,0,.25); }
  .scroll-hint span { width: 22px; height: 34px; border: 1.5px solid rgba(255,255,255,.75); border-radius: 999px; }
  .scroll-hint span::after { content: ''; display: block; width: 3px; height: 7px; margin: 7px auto; border-radius: 4px; background: white; }
  @media (max-width: 720px) { .hero { min-height: 760px; border-radius: 0 0 24px 24px; } .backdrop { background-position: 58% center; } .backdrop::after { background: linear-gradient(180deg, rgba(235,247,255,.3), rgba(248,251,255,.2) 55%, rgba(0,28,55,.14)); } .hero-content { margin-top: 84px; width: min(100% - 32px, 560px); } .eyebrow { display: block; } h1 { font-size: clamp(34px, 8.5vw, 48px); line-height: 1.06; letter-spacing: -.05em; } .intro { margin-top: 18px; font-size: 18px; line-height: 1.42; } .desktop-break { display: none; } .cta-row { flex-direction: column; align-items: stretch; margin: 26px auto 0; max-width: 325px; } .button { min-height: 56px; } .hero-perks { flex-direction: column; align-items: stretch; max-width: 325px; margin: 18px auto 0; gap: 8px; } .perk-pill { justify-content: center; padding: 10px 16px; } .scroll-hint { display: none; } }
</style>

---
const navigation = [
  { label: 'How It Works', href: '#process' },
  { label: '1031 Exchange', href: '#services' },
  { label: 'Resources', href: '#resources' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---
<header class="site-header">
  <a class="brand" href="#" aria-label="1031 CapEx home">
    <img src="/images/1031-capex-logo.png" alt="1031 CapEx" />
  </a>
  <nav aria-label="Primary navigation">
    {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="header-actions"><a class="start" href="#contact">Get Started <span aria-hidden="true">→</span></a></div>
</header>

<style>
  .site-header {
    position: relative; z-index: 2; display: flex; align-items: center; gap: clamp(18px, 2.5vw, 32px);
    width: min(1440px, calc(100% - 48px)); min-height: 84px; margin: 14px auto 0;
    padding: 10px 18px 10px 26px; border: 1px solid rgba(255,255,255,.72);
    border-radius: 999px; background: rgba(255,255,255,.96); box-shadow: 0 14px 34px rgba(4, 38, 95, .11);
  }
  .brand { display: flex; align-items: center; flex: 1; min-width: 120px; }
  .brand img { height: 52px; width: auto; max-width: 220px; object-fit: contain; object-position: left center; }
  nav { display: flex; align-items: center; justify-content: center; gap: clamp(18px, 2vw, 37px); white-space: nowrap; }
  nav a { font-weight: 600; font-size: 13px; color: #08245a; transition: color .2s ease; }
  nav a:hover { color: #0072ce; }
  .header-actions { display: flex; align-items: center; gap: 12px; margin-left: auto; }
  .start { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 22px; border-radius: 999px; font-weight: 700; font-size: 13px; white-space: nowrap; gap: 8px; color: white; background: #0874c9; box-shadow: inset 0 0 0 1px rgba(255,255,255,.15); }
  .start:hover { background: #0568b4; }
  .start span { font-size: 18px; line-height: 1; }
  @media (max-width: 1050px) { nav { display: none; } .brand { flex: 1; } }
  @media (max-width: 600px) { .site-header { width: calc(100% - 28px); min-height: 74px; margin-top: 14px; padding: 8px 12px 8px 18px; } .brand { min-width: 0; } .brand img { height: 42px; width: auto; max-width: 170px; } .start { min-height: 42px; padding: 0 16px; font-size: 13px; } }
</style>
